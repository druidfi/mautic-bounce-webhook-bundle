{
    "name": "druidfi/mautic-bounce-webhook-bundle",
    "description": "Handles mailer transport webhook callbacks for bounce and spam events in Mautic.",
    "type": "mautic-plugin",
    "license": "GPL-3.0-only",
    "authors": [
        {
            "name": "Druid"
        }
    ],
    "keywords": [
        "mautic",
        "plugin",
        "bounce",
        "webhook",
        "mailjet",
        "email"
    ],
    "require": {
        "php": "^8.1|^8.2|^8.3",
        "ext-json": "*",
        "mautic/core-lib": "^5.0|^6.0|^7.0"
    },
    "require-dev": {
        "phpunit/phpunit": "13.3.5",
        "symfony/http-foundation": "^6.0|^7.0"
    },
    "autoload": {
        "psr-4": {
            "MauticPlugin\\MauticBounceWebhookBundle\\": ""
        }
    },
    "autoload-dev": {
        "psr-4": {
            "MauticPlugin\\MauticBounceWebhookBundle\\Tests\\": "Tests/"
        }
    },
    "extra": {
        "install-directory-name": "MauticBounceWebhookBundle"
    }
}
